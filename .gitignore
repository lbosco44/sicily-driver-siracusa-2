# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...ma il template di esempio (solo placeholder, nessun segreto) va committato
!.env.example

# company profile: sorgente (html/css) versionato; PDF e immagini generati no
/company-profile/*.pdf
/company-profile/_img/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.gstack/

# playwright MCP scratch (screenshots, snapshots, console logs)
.playwright-mcp/

# archivio visivo sito vecchio (binario)
/before-old-site-home.png
