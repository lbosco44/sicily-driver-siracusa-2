# Sicily Driver — variabili d'ambiente
# Copia in .env.local per lo sviluppo, e imposta le stesse su Vercel (Project
# Settings → Environment Variables) per la produzione. NON committare valori reali.

# --- Email lead (Resend) ---
# Chiave API del progetto Resend. Senza questa, i form NON inviano (in preview
# mostrano comunque conferma; vedi lib/email.ts).
RESEND_API_KEY=

# Casella del cliente dove devono arrivare le richieste dei form.
LEAD_TO_EMAIL=

# Mittente degli invii: deve essere su un dominio verificato su Resend
# (es. noreply@ncctaxisiracusa.com). Se omesso usa il default in lib/email.ts.
LEAD_FROM_EMAIL=

# --- Google Analytics 4 ---
# Measurement ID della property GA4 (formato G-XXXXXXXXXX). Senza questo,
# il componente Analytics non carica nulla (vedi components/layout/Analytics.tsx).
NEXT_PUBLIC_GA_ID=
